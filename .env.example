# Contact form endpoint (optional).
# Create a free form at formspree.io (or any service that accepts a JSON POST) and paste its URL here.
# Without it, the form validates and then opens the visitor's email app addressed to ceo@eigentech.ai.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Only needed if the site is served from https://<user>.github.io/eigentech-website instead of www.eigentech.ai
NEXT_PUBLIC_BASE_PATH=
